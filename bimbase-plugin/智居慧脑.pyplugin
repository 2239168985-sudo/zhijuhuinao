<?xml version="1.0" encoding="UTF-8"?>
<BIMPyPlugin>
    <BfaLibName>智居慧脑</BfaLibName>
    <PluginVersion>1.0.1</PluginVersion>
    <LoadStatus>true</LoadStatus>
    <Category name="智居慧脑">
        <Panel name="快速访问">
            <Button name="打开展示站">
                <command>open_site.py</command>
                <iconPath>open_site.ico</iconPath>
            </Button>
            <Button name="构件库总览">
                <command>open_components.py</command>
