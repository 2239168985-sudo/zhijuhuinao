            </Button>
            <Button name="导出BIMBase构件清单">
                <command>export_bimbase_components.py</command>
                <iconPath>export.ico</iconPath>
            </Button>
        </Panel>
    </Category>
    <Name>智居慧脑</Name>
    <PluginModule>C:\ProgramData\PKPM\BIMBase\Plugins\Pro\V1.6\pythonplugin\智居慧脑\</PluginModule>
    <PluginSDKVersion>1.6.2</PluginSDKVersion>
